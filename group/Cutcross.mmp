TARGET			Cutcross.exe
UID				0x100039CE 0x27B05413
VENDORID		0
TARGETTYPE		exe
EPOCSTACKSIZE	0x5000

SYSTEMINCLUDE	\epoc32\include \epoc32\include\variant \epoc32\include\ecom \epoc32\include\libc
USERINCLUDE		..\inc ..\data

SOURCEPATH ..\data\client
START RESOURCE	Cutcross.rss
HEADER
TARGETPATH		resource\apps
END // RESOURCE

START RESOURCE Cutcross_reg.rss
TARGETPATH		\private\10003a3f\apps
END // RESOURCE

LIBRARY			euser.lib apparc.lib cone.lib eikcore.lib avkon.lib
LIBRARY			commonengine.lib efsrv.lib estor.lib eikcoctl.lib eikdlg.lib 
LIBRARY			eikctl.lib bafl.lib fbscli.lib aknnotify.lib aknicon.lib
LIBRARY			etext.lib gdi.lib egul.lib insock.lib
LIBRARY			ecom.lib InetProtUtil.lib http.lib esock.lib hwrmvibraclient.lib estlib.lib

LANG			01

START BITMAP	Cutcross.mbm
HEADER
TARGETPATH		\resource\apps
SOURCEPATH		..\gfx
SOURCE	c12,1	list_icon.bmp list_icon_mask.bmp
END


#ifdef ENABLE_ABIV2_MODE
DEBUGGABLE_UDEBONLY
#endif

SOURCEPATH ..\src\common
SOURCE FileHandler.cpp
SOURCEPATH ..\src\server
SOURCE ActionController.cpp ConditionActionController.cpp TimeController.cpp
SOURCEPATH ..\src\client
SOURCE CutcrossAppUi.cpp CutcrossApplication.cpp CutcrossContainer.cpp CutcrossContainerView.cpp CutcrossDocument.cpp
