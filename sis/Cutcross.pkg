; Language
&EN

; It has been impossible to sign with Symbian keys for protected UID3s
; (0x20000000-0x2FFFFFFF) for over a decade now. However, we require one of
; these UID3s for full functionality/access to hardware. So, use our own
; randomly generated UID3 in this range, and just require a jailbroken device
; (which is very easy to do nowadays).
;
; Last three numbers make up a version number (e.g. 0,0,1 == 0.0.1)
#{"Cutcross"},(0x27B05415),0,0,1

; Localised Vendor name
%{"Aiden Isik"}

; Unique Vendor name
:"Aiden Isik"

; Supports S60v3 (Symbian 9.1)
[0x101F7961], 0, 0, 0, {"S60v3"}

; Client files to install
"$(EPOCROOT)Epoc32\release\$(PLATFORM)\$(TARGET)\Cutcross.exe"			-"c:\sys\bin\Cutcross.exe"
"$(EPOCROOT)Epoc32\data\z\resource\apps\Cutcross.r01"					-"c:\resource\apps\Cutcross.r01"
"$(EPOCROOT)Epoc32\data\z\private\10003a3f\apps\Cutcross_reg.r01"		-"c:\private\10003a3f\import\apps\Cutcross_reg.r01"
"$(EPOCROOT)epoc32\data\z\resource\apps\Cutcross_aif.mif"				-"c:\resource\apps\Cutcross_aif.mif"
"$(EPOCROOT)epoc32\data\z\resource\apps\Cutcross.mbm"					-"c:\resource\apps\Cutcross.mbm"
"stub"										 							-"c:\private\27B05414\stub"

; Server files to install
"$(EPOCROOT)Epoc32\release\$(PLATFORM)\$(TARGET)\CutcrossServer.exe"	-"!:\sys\bin\CutcrossServer.exe"