#include "CutcrossContainer.hrh"
#include "CutcrossContainer.loc"

RESOURCE AVKON_VIEW r_cutcross_container_cutcross_container_view
{
	cba = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
	menubar = r_cutcross_container_options_menu;
	toolbar = 0;
}

RESOURCE MENU_BAR r_cutcross_container_options_menu
{
	titles =
	{
		MENU_TITLE
		{
			menu_pane = r_cutcross_container_menu_pane1_menu_pane;
		}
	};
}

RESOURCE STATUS_PANE_APP_MODEL r_cutcross_container_status_pane
{
	panes =
	{
		SPANE_PANE
		{
			id = EEikStatusPaneUidTitle;
			type = EAknCtTitlePane;
			resource = r_cutcross_container_title_resource;
		}
	};
}

RESOURCE TITLE_PANE r_cutcross_container_title_resource
{
	txt = STR_CutcrossContainerView_3;
}

RESOURCE MENU_PANE r_cutcross_container_menu_pane1_menu_pane
{
	items =
	{
		MENU_ITEM
		{
		command = ECutcrossContainerViewDebugging_InfoMenuItemCommand;
		txt = STR_CutcrossContainerView_4;
		}
	};
}
