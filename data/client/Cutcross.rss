// Condition prompt resources

RESOURCE DIALOG r_application_cutcross_query_condition_year
{
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
    items =
    {
        DLG_LINE
        {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_DATA_QUERY
            {
                layout = ENumberLayout;
                label = "Enter year and press \"Ok\", or \"Cancel\" to not set a year:";
                control = AVKON_INTEGER_EDWIN
                {
                    min = 0;
                    max = 65535;
                    maxlength = 5;
                };
            };
        }
    };
}

